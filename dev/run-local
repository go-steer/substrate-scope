# Run the collector on your machine against a real cluster, serving web/ from
# disk so front-end edits show up on reload.
#
# It port-forwards Substrate's API server and ax-server, mints a short-lived
# token for the substrate-scope service account (kubectl apply -f deploy/
# first) and fetches the servicedns CA bundle. Credentials go to .dev/
# (git-ignored).
#
# The atenet router (runner status, attach) is off by default: since
# Substrate v0.6 it serves only mTLS with a pod certificate, which a
# workstation doesn't have. ROUTER=http://host:port points the collector at
# a plain-HTTP stand-in instead.
#
#   CONTEXT=agent-substrate dev/run-local            # UI on http://localhost:8080
#   ROUTER=http://127.0.0.1:18081 ATTACH_TOKEN_FILE=path dev/run-local
#                                                    # router stand-in + attach proxy
#
# On a Cloud Workstation, open the UI through its port proxy: that rewrites
# Host, so pages from *.cloudworkstations.dev are allowed here by default
# (SCOPE_ALLOWED_ORIGINS= turns that off). The deployed collector allows only
# its own host.
set -euo pipefail
cd "$(dirname "$0")/.."
CONTEXT=${CONTEXT:-$(kubectl config current-context)}
export SCOPE_ALLOWED_ORIGINS=${SCOPE_ALLOWED_ORIGINS-*.cloudworkstations.dev}
K="kubectl --context $CONTEXT"
mkdir -p .dev
chmod 700 .dev

$K -n substrate-scope create token substrate-scope --audience api.ate-system.svc --duration 2h > .dev/ate-token
$K get clustertrustbundles -l podcert.ate.dev/canarying=live \
  -o jsonpath='{range .items[?(@.spec.signerName=="servicedns.podcert.ate.dev/identity")]}{.spec.trustBundle}{end}' > .dev/ca.pem

pids=()
cleanup() { kill "${pids[@]}" 2>/dev/null || true; }
trap cleanup EXIT
$K -n ate-system port-forward deploy/ate-api-server 18443:443 >/dev/null & pids+=($!)
$K -n ax-system port-forward svc/ax-server 18080:8080 >/dev/null & pids+=($!)
sleep 2

attach=()
if [[ -n "${ATTACH_TOKEN_FILE:-}" ]]; then attach=(--attach-token-file="$ATTACH_TOKEN_FILE"); fi
go run ./cmd/substrate-scope \
  --addr="${ADDR:-127.0.0.1:8080}" \
  --cluster="$CONTEXT" \
  --web-dir=web \
  --substrate-endpoint=127.0.0.1:18443 \
  --substrate-authority=api.ate-system.svc \
  --substrate-token-file=.dev/ate-token \
  --substrate-ca-file=.dev/ca.pem \
  --ax-endpoint=127.0.0.1:18080 \
  --router="${ROUTER:-}" \
  "${attach[@]}" "$@"
